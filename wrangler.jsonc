{
  "name": "tao",
  "account_id": "cb08826ea543ac8c950a73d3a0b982b2",
  "compatibility_date": "2026-11-01",
  // The Worker answers POST /api/e (anonymous usage events into D1); every
  // other request is a static file from ./app.
  "main": "worker/index.js",
  // Hash router: no SPA fallback, so a missing JSON/font is a real 404.
  // The service worker caches the shell under "./" (not "index.html").
  "assets": { "directory": "./app", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "tao_analytics", "database_name": "tao-analytics", "database_id": "067ecf84-5409-49fa-9c17-ef6ad1df6938" },
    // Optional passkey journal sync (worker/sync.js, schema worker/sync-schema.sql).
    { "binding": "tao_sync", "database_name": "tao-sync", "database_id": "8cbbbe43-9992-4807-90f0-62e7296cb11b" }
  ],
  // Passkeys are bound to this RP ID and origin. `.dev.vars` overrides them for `npm run dev` on localhost.
  "vars": { "RP_ID": "tao.tensor.group", "ORIGIN": "https://tao.tensor.group" },
  // Per-IP request limits for sync and analytics (the IP is used for counting only, never stored). Namespace
  // ids are per Cloudflare account: no other Worker on the account may use 4111–4114. Taken blocks:
  // 4101–4104 (tensor-tarot) and 4201–4204 (Book of Changes). Over EVENTS_LIMIT, analytics events are
  // dropped silently; a missing sync limit answers 503 (worker/sync.js).
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "4111", "simple": { "limit": 20, "period": 60 } },
    { "name": "SYNC_LIMIT", "namespace_id": "4112", "simple": { "limit": 60, "period": 60 } },
    { "name": "SIGNUP_LIMIT", "namespace_id": "4113", "simple": { "limit": 3, "period": 60 } },
    { "name": "EVENTS_LIMIT", "namespace_id": "4114", "simple": { "limit": 60, "period": 60 } }
  ],
  "routes": [{ "pattern": "tao.tensor.group", "custom_domain": true }],
  // Only that domain: passkeys fail on a *.workers.dev or preview origin, and such a copy of the site
  // would keep a separate journal in the browser.
  "workers_dev": false,
  "preview_urls": false
}
